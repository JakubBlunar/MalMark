# Only used by build:store / package:store for direct sign-in in store distributions.
# GitHub/unpacked builds ignore this value and ask users for their own public client ID.
# Register an app of type Other. Never put a client secret in a browser extension.
VITE_MAL_CLIENT_ID=

# Optional: Chrome Web Store draft > Package > View public key (single-line base64).
# Pins the unpacked store build for local OAuth testing; store-upload ZIPs omit manifest.key.
# Never use a private key.
VITE_CHROMIUM_PUBLIC_KEY=
